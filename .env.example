# Copy to .env and replace every change_me value:  cp .env.example .env
# Use letters and digits only in passwords (they are inserted into init SQL scripts).
# Never commit the real .env.

# --- MySQL (raw data) ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=analytics_db

# One MySQL account per service, each with only the privileges it needs
AUTH_DB_USER=auth_svc
AUTH_DB_PASSWORD=change_me
ENTER_DB_USER=enter_svc
ENTER_DB_PASSWORD=change_me
ANALYTICS_DB_USER=analytics_svc
ANALYTICS_DB_PASSWORD=change_me

# --- MongoDB (computed analytics) ---
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=change_me
MONGO_DB=analytics
MONGO_WRITER_USER=analytics_writer
MONGO_WRITER_PASSWORD=change_me
MONGO_READER_USER=results_reader
MONGO_READER_PASSWORD=change_me

# --- Authentication ---
# Long random string, e.g.:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
# First login account, created by the auth service on startup if missing
SEED_USERNAME=demo
SEED_PASSWORD=change_me

# --- Analytics ---
ANALYTICS_INTERVAL_SECONDS=30

# Set to true only when serving over HTTPS
COOKIE_SECURE=false
